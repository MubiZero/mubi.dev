---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Page from '../../components/v2/Page.astro';
import { loadSitePage } from '../../lib/content';

const { ui, profile, contact } = await loadSitePage('ru');
---

<SiteLayout
  locale="ru"
  title={ui.siteTitle}
  description={ui.metaDescription}
  profile={profile}
  contact={contact}
>
  <Page locale="ru" />
</SiteLayout>
