---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Proof from '../../components/Proof.astro';
import Capabilities from '../../components/Capabilities.astro';
import Cases from '../../components/Cases.astro';
import Experience from '../../components/Experience.astro';
import Education from '../../components/Education.astro';
import Stack from '../../components/Stack.astro';
import Contact from '../../components/Contact.astro';
import { loadPage } from '../../lib/content';

const page = await loadPage('ru');
---

<BaseLayout locale="ru" ui={page.ui} profile={page.profile} contact={page.contact}>
  <Header locale="ru" controls={page.ui.controls} navigation={page.ui.navigation} skipToContent={page.ui.labels.skipToContent} />
  <main id="main-content" class="site-main">
    <Hero profile={page.profile} contact={page.contact} />
    <Proof items={page.profile.proof} sectionLabel={page.ui.labels.proof} />
    <Cases entries={page.cases.entries} sectionLabel={page.ui.labels.selectedWork} labels={page.ui.caseLabels} openDetails={page.ui.labels.openDetails} />
    <Capabilities label={page.ui.navigation.expertise} title={page.ui.capabilities.title} items={page.ui.capabilities.items} />
    <div class="journey-grid">
      <Experience entries={page.experience.entries} printEntries={page.experience.printEntries} sectionLabel={page.ui.labels.journey} />
      <Education entries={page.education.entries} sectionLabel={page.ui.labels.education} />
    </div>
    <Stack groups={page.stack.groups} label={page.ui.labels.toolkit} />
    <Contact contact={page.contact} sectionLabel={page.ui.sections.contact} title={page.ui.labels.contactTitle} lead={page.ui.labels.contactLead} />
  </main>
</BaseLayout>
