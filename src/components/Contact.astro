---
import { Icon } from 'astro-icon/components';

interface Props {
  contact: { email: string; links: { label: string; url: string }[] };
  lead: string;
  action: string;
  copyLabels: { idle: string; done: string; failed: string };
}

const { contact, lead, action, copyLabels } = Astro.props;
---

<p class="lede">{lead}</p>

<div class="contact__row">
  <a
    class="contact__mail"
    data-testid="contact-mail"
    href={`mailto:${contact.email}`}
    aria-label={`${action}: ${contact.email}`}
  >
    <span>{contact.email}</span>
    <Icon name="ph:arrow-up-right" size="20" aria-hidden="true" />
  </a>

  <!-- Writing to the clipboard is instant and reversible, so the result is
       reported next to the button instead of as a toast to dismiss. The
       button's own label never changes: three labels of three different
       lengths would resize it exactly as the reader looks at it. -->
  <button
    class="copy"
    type="button"
    data-copy={contact.email}
    data-label-done={copyLabels.done}
    data-label-failed={copyLabels.failed}
  >
    <Icon class="copy__icon copy__icon--idle" name="ph:copy" size="15" aria-hidden="true" />
    <Icon class="copy__icon copy__icon--done" name="ph:check" size="15" aria-hidden="true" />
    {copyLabels.idle}
  </button>

  <span class="copy__status" data-copy-status role="status"></span>
</div>

<div class="social contact__links" data-testid="contact-links">
  {
    contact.links.map((link) => (
      <a href={link.url} rel="me noopener">
        {link.label}
      </a>
    ))
  }
</div>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-copy]');
    if (!button) return;

    const status = document.querySelector('[data-copy-status]');
    let revert;

    const report = (state) => {
      clearTimeout(revert);
      button.dataset.state = state;
      status.textContent = button.dataset[state === 'done' ? 'labelDone' : 'labelFailed'];
      revert = setTimeout(() => {
        delete button.dataset.state;
        status.textContent = '';
      }, 2400);
    };

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy);
        report('done');
      } catch {
        report('failed');
      }
    });
  })();
</script>

<style>
  .social a {
    width: auto;
    padding-inline: var(--space-4);
    font-family: var(--display);
    font-size: 0.68rem;
    font-stretch: 85%;
    text-decoration: none;
  }
</style>
