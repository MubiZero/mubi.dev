---
import { Icon } from 'astro-icon/components';

interface Props {
  contact: { email: string; links: { label: string; url: string }[] };
  sectionLabel: string;
  title: string;
  lead: string;
}

const { contact, sectionLabel, title, lead } = Astro.props;
const socialIcons: Record<string, string> = {
  GitHub: 'simple-icons:github',
  LinkedIn: 'simple-icons:linkedin',
  Telegram: 'simple-icons:telegram',
};
---

<section id="contact" class="module contact-module" aria-labelledby="contact-title">
  <div>
    <span class="module-label">{sectionLabel}</span>
    <h2 id="contact-title" class="contact-title">{title}</h2>
    <p class="contact-lead">{lead}</p>
  </div>

  <div data-testid="contact-links" class="contact-links">
    <a data-testid="contact-email" class="button contact-email" href={`mailto:${contact.email}`}>
      <Icon name="ph:envelope" size="18" aria-hidden="true" />
      {contact.email}
    </a>
    {
      contact.links.map((link) => (
        <a class="social-link" href={link.url} rel="me noopener" aria-label={link.label}>
          <Icon name={socialIcons[link.label] ?? 'ph:link'} size="20" aria-hidden="true" />
        </a>
      ))
    }
  </div>
</section>
