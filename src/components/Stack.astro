---
import TechIcon from './TechIcon.astro';

interface Props {
  groups: { label: string; items: string[] }[];
  label: string;
}

const { groups, label } = Astro.props;
const items = groups.flatMap((group) => group.items);
---

<section id="stack" class="module stack-module" aria-labelledby="stack-title">
  <span class="module-label" id="stack-title">{label}</span>
  <ul class="stack-rail">
    {
      items.map((item) => (
        <li class="stack-chip">
          <TechIcon name={item} />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</section>
