---
import TechIcon from './TechIcon.astro';

interface Props {
  groups: { label: string; items: string[] }[];
  label: string;
}

const { groups, label } = Astro.props;
---

<section id="stack" class="module stack-module" aria-labelledby="stack-title">
  <h2 id="stack-title" class="section-title">{label}</h2>
  <div class="stack-groups">
    {
      groups.map((group, index) => (
        <section data-testid="stack-group" class="stack-group" aria-labelledby={`stack-group-${index}`}>
          <h3 id={`stack-group-${index}`} class="stack-group-title">{group.label}</h3>
          <ul class="stack-list">
            {group.items.map((item) => (
              <li class="stack-item">
                <TechIcon name={item} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>
