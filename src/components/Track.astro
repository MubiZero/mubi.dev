---
interface Entry {
  period: string;
  employer: string;
  role: string;
  lines: string[];
}

interface Props {
  entries: Entry[];
  printEntries: Entry[];
  education: { degree: string; institution: string; period: string; details: string[] }[];
  educationTitle: string;
}

const { entries, printEntries, education, educationTitle } = Astro.props;
---

<div class="track">
  <div class="track__screen">
    {
      entries.map((entry) => (
        <article class="track__entry" data-testid="track-entry">
          <p class="track__period">{entry.period}</p>
          <div>
            <p class="track__role">{entry.role}</p>
            <p class="track__employer">{entry.employer}</p>
          </div>
          <div class="track__lines">
            {entry.lines.map((line) => (
              <p>{line}</p>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  {/* The condensed history exists only for the printed resume, where the full
      screen version would not leave room for education, stack, and contacts. */}
  <div class="track__print">
    {
      printEntries.map((entry) => (
        <article class="track__entry">
          <p class="track__period">{entry.period}</p>
          <div>
            <p class="track__role">{entry.role}</p>
            <p class="track__employer">{entry.employer}</p>
          </div>
          <div class="track__lines">
            {entry.lines.map((line) => (
              <p>{line}</p>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <div class="education">
    <h3>{educationTitle}</h3>
    {
      education.map((entry) => (
        <article class="track__entry">
          <p class="track__period">{entry.period}</p>
          <div>
            <p class="track__role">{entry.degree}</p>
            <p class="track__employer">{entry.institution}</p>
            {entry.details.length > 0 && (
              <p class="track__period">{entry.details.join(' · ')}</p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</div>
