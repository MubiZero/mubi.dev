---
interface Props {
  items: { value: string; label: string }[];
  sectionLabel: string;
}

const { items, sectionLabel } = Astro.props;
---

<section id="proof" class="module proof-module" aria-labelledby="proof-title">
  <h2 id="proof-title" class="section-title">{sectionLabel}</h2>
  <ul class="proof-list">
    {
      items.map((item) => (
        <li data-testid="proof-item" class="proof-item">
          <strong class="proof-value">{item.value}</strong>
          <span class="proof-label">{item.label}</span>
        </li>
      ))
    }
  </ul>
</section>
