---
interface Props {
  entries: { period: string; employer: string; role: string; lines: string[] }[];
  printEntries: { period: string; employer: string; role: string; lines: string[] }[];
  sectionLabel: string;
}

const { entries, printEntries, sectionLabel } = Astro.props;
---

<section id="experience" class="module experience-module" aria-labelledby="experience-title">
  <span class="module-label">{sectionLabel}</span>
  <h2 id="experience-title" class="section-title">{sectionLabel}</h2>

  <ol class="experience-list screen-experience">
    {
      entries.map((entry) => (
        <li data-testid="experience-entry" class="experience-entry">
          <p class="entry-period">{entry.period}</p>
          <h3>{entry.employer}</h3>
          <p class="entry-role">{entry.role}</p>
          <div class="entry-lines">
            {entry.lines.map((line) => <p>{line}</p>)}
          </div>
        </li>
      ))
    }
  </ol>

  <ol class="print-experience">
    {
      printEntries.map((entry) => (
        <li class="experience-entry">
          <p class="entry-period">{entry.period}</p>
          <h3>{entry.employer}</h3>
          <p class="entry-role">{entry.role}</p>
          <div class="entry-lines">
            {entry.lines.map((line) => <p>{line}</p>)}
          </div>
        </li>
      ))
    }
  </ol>
</section>
