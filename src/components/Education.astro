---
interface Props {
  entries: { degree: string; institution: string; period: string; details: string[] }[];
  sectionLabel: string;
}

const { entries, sectionLabel } = Astro.props;
---

<section id="education" class="module education-module" aria-labelledby="education-title">
  <span class="module-label">{sectionLabel}</span>
  <h2 id="education-title" class="section-title">{sectionLabel}</h2>
  <ol class="education-list">
    {
      entries.map((entry) => (
        <li data-testid="education-entry" class="education-entry">
          <p class="entry-period">{entry.period}</p>
          <h3>{entry.institution}</h3>
          <p class="entry-role">{entry.degree}</p>
          {entry.details.map((detail) => <p class="entry-meta">{detail}</p>)}
        </li>
      ))
    }
  </ol>
</section>
