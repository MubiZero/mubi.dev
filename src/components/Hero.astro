---
import { Icon } from 'astro-icon/components';

interface Props {
  profile: {
    name: string;
    manLine: string;
    summary: string[];
    ctaLabel: string;
  };
  contact: { email: string; links: { label: string; url: string }[] };
}

const { profile, contact } = Astro.props;
const socialIcons: Record<string, string> = {
  GitHub: 'simple-icons:github',
  LinkedIn: 'simple-icons:linkedin',
  Telegram: 'simple-icons:telegram',
};
---

<section id="home" class="module hero-module" aria-labelledby="hero-title">
  <span class="module-label">mubi.dev</span>

  <div class="hero-copy">
    <h1 id="hero-title">{profile.name}</h1>
    <p class="hero-role">{profile.manLine}</p>
    <div class="hero-summary">
      {profile.summary.map((sentence) => <p>{sentence}</p>)}
    </div>
  </div>

  <div class="hero-actions">
    <a data-testid="hero-cta" class="button" href={`mailto:${contact.email}`}>
      {profile.ctaLabel}
      <Icon name="ph:arrow-up-right" size="18" aria-hidden="true" />
    </a>
    {
      contact.links.map((link) => (
        <a class="social-link" href={link.url} rel="me noopener" aria-label={link.label}>
          <Icon name={socialIcons[link.label] ?? 'ph:link'} size="20" aria-hidden="true" />
        </a>
      ))
    }
  </div>
</section>
