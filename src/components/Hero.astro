---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import portrait from '../assets/portrait.jpg';

interface Props {
  profile: {
    name: string;
    summary: string[];
    now: { role: string; employer: string; location: string };
    ctaLabel: string;
  };
  contact: { email: string; links: { label: string; url: string }[] };
  lead: string;
  availability: string;
  proof: { metric: string; label: string }[];
  printLabel: string;
}

const { profile, contact, lead, availability, proof, printLabel } = Astro.props;
const socialIcons: Record<string, string> = {
  GitHub: 'simple-icons:github',
  LinkedIn: 'simple-icons:linkedin',
  Telegram: 'simple-icons:telegram',
};
const role = [profile.now.role, profile.now.employer, profile.now.location].join(' · ');
---

<section id="home" class="section hero" aria-labelledby="hero-title">
  <div class="hero__copy">
    <h1 id="hero-title">{profile.name}</h1>
    <p class="hero__role">{role}</p>
    <p class="hero__lead">{lead}</p>

    <!-- The measured results sit above the prose because a reader who leaves
         after five seconds has read only this far. The cases below carry the
         same figures with their context. -->
    <dl class="proof">
      {
        proof.map((item) => (
          <div class="proof__item">
            <dt>{item.metric}</dt>
            <dd>{item.label}</dd>
          </div>
        ))
      }
    </dl>

    <div class="hero__summary">
      {profile.summary.map((sentence) => <p>{sentence}</p>)}
    </div>

    <p class="hero__availability">{availability}</p>

    <div class="actions">
      <a class="button" data-testid="hero-cta" href={`mailto:${contact.email}`}>
        {profile.ctaLabel}
        <Icon name="ph:arrow-up-right" size="16" aria-hidden="true" />
      </a>
      <div class="social">
        {
          contact.links.map((link) => (
            <a href={link.url} rel="me noopener" aria-label={link.label}>
              <Icon name={socialIcons[link.label] ?? 'ph:link'} size="18" aria-hidden="true" />
            </a>
          ))
        }
        <button type="button" data-print aria-label={printLabel}>
          <Icon name="ph:printer" size="18" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>

  <div class="hero__portrait">
    <!-- These are the width the image is painted at, not the width of the box:
         object-fit cover scales a square source to the taller side, so the
         220px desktop column with its 460px cap needs about 400px of image.
         The phone box is a plain 88px square, and stating it stops every
         retina phone from downloading the 800w candidate for a thumbnail. -->
    <Image
      src={portrait}
      alt={profile.name}
      widths={[400, 800]}
      sizes="(max-width: 720px) 88px, (max-width: 900px) 275px, 400px"
      loading="eager"
    />
  </div>
</section>

<script is:inline>
  document
    .querySelector('[data-print]')
    ?.addEventListener('click', () => window.print());
</script>
