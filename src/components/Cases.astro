---
interface Props {
  entries: { title: string; problem: string; action: string; result: string }[];
  sectionLabel: string;
  labels: { problem: string; action: string; result: string };
  openDetails: string;
}

const { entries, sectionLabel, labels, openDetails } = Astro.props;
---

<section id="work" class="module work-module" aria-labelledby="work-title">
  <span class="module-label">{sectionLabel}</span>
  <h2 id="work-title" class="section-title">{sectionLabel}</h2>

  <div class="case-grid">
    {
      entries.map((entry) => (
        <article data-testid="case-entry" class="case-card">
          <span class="module-label">{labels.result}</span>
          <h3>{entry.title}</h3>
          <p class="case-result">{entry.result}</p>
          <details>
            <summary>{openDetails}</summary>
            <dl class="case-details">
              <div>
                <dt>{labels.problem}</dt>
                <dd>{entry.problem}</dd>
              </div>
              <div>
                <dt>{labels.action}</dt>
                <dd>{entry.action}</dd>
              </div>
            </dl>
          </details>
        </article>
      ))
    }
  </div>
</section>
