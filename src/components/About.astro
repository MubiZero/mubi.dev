---
interface Props {
  label: string;
  title: string;
  lead: string;
  principle: string;
  summary: string[];
}

const { label, title, lead, principle, summary } = Astro.props;
---

<section id="about" class="module about-module" aria-labelledby="about-title">
  <span class="module-label">{label}</span>
  <h2 id="about-title" class="about-title">{title}</h2>
  <div class="about-copy">
    {summary.map((sentence) => <p>{sentence}</p>)}
    <p>{lead}</p>
  </div>
  <p class="principle">{principle}</p>
</section>
