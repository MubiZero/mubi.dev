---
import TechIcon from './TechIcon.astro';

interface Props {
  groups: { label: string; items: string[] }[];
  label: string;
  title: string;
}

const { groups, label, title } = Astro.props;
const preferred = ['Linux', 'Docker', 'Terraform', 'Ansible', 'RKE2', 'Prometheus', 'Go', 'Flutter'];
const allItems = groups.flatMap((group) => group.items);
const items = preferred.filter((item) => allItems.includes(item));
---

<section class="module workspace-module" aria-labelledby="workspace-title">
  <span class="module-label">{label}</span>
  <p id="workspace-title" class="workspace-heading">{title}</p>

  <ul class="workspace-grid">
    {
      items.map((item) => (
        <li>
          <a class="tech-tile" href="#expertise" title={item}>
            <TechIcon name={item} />
            <span>{item}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
