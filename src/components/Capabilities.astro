---
interface Props {
  label: string;
  title: string;
  items: { title: string; description: string }[];
}

const { label, title, items } = Astro.props;
---

<section id="expertise" class="module capabilities-module" aria-labelledby="expertise-title">
  <span class="module-label">{label}</span>
  <h2 id="expertise-title" class="section-title">{title}</h2>

  <ol class="capability-list">
    {
      items.map((item) => (
        <li class="capability-row">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </li>
      ))
    }
  </ol>
</section>
