---
import { Icon } from 'astro-icon/components';
import { localizedPath, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  mark: string;
  nav: {
    label: string;
    open: string;
    close: string;
    practice: string;
    work: string;
    track: string;
    projects: string;
    code: string;
    contact: string;
  };
  controls: {
    switchLanguage: string;
    switchToDark: string;
    switchToLight: string;
    otherLanguageName: string;
  };
}

const { locale, mark, nav, controls } = Astro.props;

/**
 * Both codes keep a fixed seat, whichever page you are on. Rendering the
 * current locale first swapped their positions on every switch, so the button
 * you just pressed slid out from under the pointer.
 */
const languages: Locale[] = ['ru', 'en'];
const items = [
  { id: 'practice', label: nav.practice },
  { id: 'work', label: nav.work },
  { id: 'track', label: nav.track },
  { id: 'projects', label: nav.projects },
  { id: 'code', label: nav.code },
  { id: 'contact', label: nav.contact },
];
---

<header class="masthead">
  <div class="masthead__inner">
    <a class="mark" href="#home">{mark}</a>

    <nav aria-label={nav.label} data-nav>
      {
        items.map((item) => (
          <a class="navlink" href={`#${item.id}`} data-section-link={item.id}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="controls">
      <span class="lang" aria-label={controls.switchLanguage}>
        {
          languages.map((code) =>
            code === locale ? (
              <span aria-current="page">{code.toUpperCase()}</span>
            ) : (
              <a
                href={localizedPath(code)}
                hreflang={code}
                aria-label={`${controls.switchLanguage}: ${controls.otherLanguageName}`}
              >
                {code.toUpperCase()}
              </a>
            ),
          )
        }
      </span>

      <!-- The section links do not fit beside the wordmark on a phone, so on a
           narrow screen they move into a sheet reached from here. Without it
           the page is six thousand pixels of scrolling with no way to jump. -->
      <button
        type="button"
        class="iconbutton menubutton"
        data-menu
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-label={nav.open}
      >
        <Icon name="ph:list" size="18" aria-hidden="true" />
      </button>

      <button
        type="button"
        id="theme-toggle"
        class="iconbutton"
        data-to-dark={controls.switchToDark}
        data-to-light={controls.switchToLight}
      >
        <Icon name="ph:sun" class="theme-icon theme-icon--sun" size="18" aria-hidden="true" />
        <Icon
          name="ph:moon"
          class="theme-icon theme-icon--moon"
          size="18"
          aria-hidden="true"
        />
      </button>
    </div>
  </div>

  <!-- How far through the page you are, on the one edge already dividing the
       header from the content. It reports position, so it carries no label. -->
  <span class="progress" data-progress aria-hidden="true"></span>
</header>

<!-- A dialog rather than a styled div: the focus trap, the Escape key and the
     inertness of the page behind it all come with the element. -->
<dialog class="sheet" data-sheet aria-label={nav.label}>
  <nav class="sheet__nav">
    {
      items.map((item) => (
        <a class="sheet__link" href={`#${item.id}`} data-section-link={item.id} data-sheet-link>
          {item.label}
        </a>
      ))
    }
  </nav>

  <button type="button" class="sheet__close" data-sheet-close>{nav.close}</button>
</dialog>

<script is:inline>
  const toggle = document.getElementById('theme-toggle');

  const renderToggle = () => {
    if (!toggle) return;
    const isDark = document.documentElement.dataset.theme === 'dark';
    toggle.setAttribute('aria-label', isDark ? toggle.dataset.toLight : toggle.dataset.toDark);
  };

  toggle?.addEventListener('click', (event) => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';

    // The preference is stored before the animation, not after: a reload part
    // way through the wave must still land on the theme that was chosen.
    try {
      localStorage.setItem('theme', next);
    } catch {}

    const apply = () => {
      document.documentElement.dataset.theme = next;
      renderToggle();
    };

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (still || !document.startViewTransition) {
      apply();
      return;
    }

    // The new theme is revealed through a circle growing from the control that
    // was pressed, so the change reads as coming from the button rather than
    // from the page at large.
    //
    // The origin is the point that was touched, not the box the button is
    // measured to be in.
    // A phone put the circle in the top left corner while the button sits top
    // right, which means the measured box was not where the button was; the
    // pointer cannot disagree with itself the same way. Keyboard activation
    // reports no point (detail 0), so the box answers for it, and a box with
    // no size falls back to the middle of the screen rather than to 0,0 - the
    // corner is the symptom being fixed here.
    const box = toggle.getBoundingClientRect();
    const pointed = event.detail > 0 && (event.clientX > 0 || event.clientY > 0);
    const x = pointed ? event.clientX : box.width ? box.left + box.width / 2 : innerWidth / 2;
    const y = pointed ? event.clientY : box.height ? box.top + box.height / 2 : innerHeight / 2;
    const reach = Math.hypot(
      Math.max(x, innerWidth - x),
      Math.max(y, innerHeight - y),
    );

    document.startViewTransition(apply).ready.then(() => {
      document.documentElement.animate(
        {
          clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${reach}px at ${x}px ${y}px)`],
        },
        {
          duration: 620,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          pseudoElement: '::view-transition-new(root)',
        },
      );
    });
  });

  renderToggle();

  (() => {
    const button = document.querySelector('[data-menu]');
    const sheet = document.querySelector('[data-sheet]');
    if (!button || !sheet) return;

    const close = () => {
      if (sheet.open) sheet.close();
    };

    button.addEventListener('click', () => {
      sheet.showModal();
      button.setAttribute('aria-expanded', 'true');
    });

    sheet.addEventListener('close', () => button.setAttribute('aria-expanded', 'false'));
    sheet.querySelector('[data-sheet-close]')?.addEventListener('click', close);

    // The jump has to survive the dialog closing, so the sheet gets out of the
    // way first and the browser is left to honour the anchor on its own.
    sheet.querySelectorAll('[data-sheet-link]').forEach((link) => {
      link.addEventListener('click', close);
    });

    // A dialog fills its backdrop area, so "outside" means outside its box
    // rather than outside the element the click landed on.
    sheet.addEventListener('click', (event) => {
      const box = sheet.getBoundingClientRect();
      const outside =
        event.clientY < box.top ||
        event.clientY > box.bottom ||
        event.clientX < box.left ||
        event.clientX > box.right;
      if (outside) close();
    });

    // Rotating a phone can widen the screen past the point where the sheet is
    // the way in, and a modal left open over the visible links traps the user.
    matchMedia('(min-width: 721px)').addEventListener('change', (event) => {
      if (event.matches) close();
    });
  })();

  // The sections live further down the document than this script, so wait for
  // the parser to finish before looking them up.
  const initializeSectionNavigation = () => {
  const links = [...document.querySelectorAll('[data-section-link]')];
  const sections = links
    .map((link) => document.getElementById(link.dataset.sectionLink))
    .filter(Boolean);

  const setCurrent = (id) => {
    links.forEach((link) => {
      if (link.dataset.sectionLink === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  links.forEach((link) => {
    link.addEventListener('click', () => setCurrent(link.dataset.sectionLink));
  });

  if (sections.length && 'IntersectionObserver' in window) {
    // Track which sections cross a narrow band near the top of the viewport
    // and mark the last one to enter it. Largest-intersection-ratio would
    // favour whichever section is shortest, and first-visible lets the tail
    // of the previous section win by a few pixels.
    const visible = new Set();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        });
        const current = [...sections].reverse().find((section) => visible.has(section.id));
        if (current) setCurrent(current.id);
      },
      { rootMargin: '-15% 0px -75% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSectionNavigation, { once: true });
  } else {
    initializeSectionNavigation();
  }

  (() => {
    const bar = document.querySelector('[data-progress]');
    if (!bar) return;

    let queued = false;
    const draw = () => {
      queued = false;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const read = scrollable > 0 ? window.scrollY / scrollable : 0;
      bar.style.setProperty('--read', Math.min(1, Math.max(0, read)).toFixed(4));
    };

    // Scroll fires far more often than the screen refreshes, so the write is
    // deferred to the frame that will actually paint it.
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(draw);
      },
      { passive: true },
    );
    addEventListener('resize', draw, { passive: true });
    draw();
  })();
</script>
