---
import { localizedPath, otherLocale, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  label: string;
  otherLanguageName: string;
}

const { locale, label, otherLanguageName } = Astro.props;
const targetLocale = otherLocale(locale);
---

<span class="language-switch" aria-label={label}>
  <span aria-current="page">{locale.toUpperCase()}</span>
  <span aria-hidden="true">/</span>
  <a href={localizedPath(targetLocale)} hreflang={targetLocale} aria-label={`${label}: ${otherLanguageName}`}>
    {targetLocale.toUpperCase()}
  </a>
</span>

<style>
  .language-switch {
    gap: 6px;
    padding: 0 11px;
  }

  .language-switch a {
    display: inline-flex;
    min-width: 40px;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-standard), transform var(--dur-short) var(--ease-standard);
  }

  .language-switch a:active {
    transform: scale(0.97);
  }

  .language-switch [aria-current='page'] {
    color: var(--text);
  }
</style>
