---
import { localizedPath, otherLocale, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
const targetLocale = otherLocale(locale);
---

<span class="language-switch" aria-label={label}>
  <span aria-current="page">{locale.toUpperCase()}</span>
  <span aria-hidden="true">/</span>
  <a href={localizedPath(targetLocale)} hreflang={targetLocale} aria-label={`${label}: ${targetLocale === 'en' ? 'English' : 'Русский'}`}>
    {targetLocale.toUpperCase()}
  </a>
</span>

<style>
  .language-switch {
    gap: 6px;
    padding: 0 11px;
  }

  .language-switch a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .language-switch [aria-current='page'] {
    color: var(--text);
  }
</style>
