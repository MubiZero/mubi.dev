---
interface Props {
  id: string;
  title: string;
  rail: string;
}

const { id, title, rail } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="section__rail">
    <h2 id={`${id}-title`}>{title}</h2>
    <p>{rail}</p>
  </div>
  <div class="section__body">
    <slot />
  </div>
</section>
